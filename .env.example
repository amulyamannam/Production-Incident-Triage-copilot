# Copy this file to .env and fill in ONE of the two backend options below.
# If neither is set, the system runs in DEMO_MODE automatically (see README).

# --- Option A: Amazon Bedrock ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# --- Option B: Anthropic API directly ---
ANTHROPIC_API_KEY=

# --- Optional overrides ---
# Force demo mode even if credentials are present (useful for CI / reproducible demos)
FORCE_DEMO_MODE=false
